# ローカル開発用の秘密情報のひな形。
# このファイルを .env にコピーして値を入れる（.env は git に入らない）。
#
#   cp .env.example .env
#
# 設定を変えたら runserver を再起動する（.env は起動時に一度だけ読む）。

# 参加フォーム（/join/）の送信に使う Azure Communication Services の認証情報。
# 両方そろっていないと送信せず、メールの内容をコンソールに出力する。
#
#   EMAIL_HOST_USER     : ACS の「SMTP ユーザー名」（Azure ポータル / az communication smtp-username）
#   EMAIL_HOST_PASSWORD : 紐づけた Microsoft Entra アプリのクライアント シークレット
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# 差出人アドレス。既定は no-reply@funitclub.org（SMTP ユーザー名とは別物）。
# JOIN_FROM_EMAIL=no-reply@funitclub.org

# 参加申し込みの通知先。未設定なら公開の問い合わせ先（contact@funitclub.org）に送る。
# 運営が実際に読む受信箱を直接指定したいときだけ設定する。
# JOIN_NOTIFY_EMAIL=

# WG への参加（WG 一覧の「WG に参加」）。すべてそろったときだけボタンが出る。
# 作り方は README の「WG への参加」を参照。
# CLUB_CLASSROOM_COURSE=          # クラブの Classroom のクラスの URL か ID（ここにいる人をメンバーとみなす）
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=         # PEM を1行で。改行は \n と書く
