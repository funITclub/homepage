# VS Code の設定ファイル。リポジトリで共有するものだけ入れる（docs/development.md）。
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Pythonのコンパイルファイル
__pycache__/
*.pyc

# Mac用
.DS_Store

# 仮想環境
venv/
.venv/

# データベース
db.sqlite3

# アップされたメディアファイル
media/

# 静的ファイル（collectstatic の出力）
staticfiles/

# Azure
.azure/

# ローカルの秘密情報（メールのアプリパスワードなど）
.env
