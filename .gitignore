# VS Code の設定ファイル。リポジトリで共有するものだけ入れる（docs/development.md）。
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Pythonのコンパイルファイル
__pycache__/
*.pyc

# Mac用
.DS_Store

# 仮想環境
venv/
.venv/

# データベース
db.sqlite3

# アップされたメディアファイル
media/

# 静的ファイル（collectstatic の出力）
staticfiles/

# Azure
.azure/

# ローカルの秘密情報（メールのアプリパスワードなど）
.env

# Google Cloud からダウンロードした OAuth クライアントの JSON（秘密）。
# 読み込んだら消す（manage.py wgjoin_google_authorize --client-json）。
client_secret*.json

# GitHub App の秘密鍵とクライアント シークレット（秘密）。.env に入れたら消す。
*.pem
github_app_secret*
